{
  "ef2a06b3f63ed53b44abab7fa313cb6d": "[\n  \"def merge_sorted_lists(a, b):\\n    # Violation 1: Result is not sorted. It simply concatenates the lists.\\n    # This passes the length check and contains all elements, but fails the implicit ascending sort order.\\n    return a + b\",\n\n  \"def merge_sorted_lists(a, b):\\n    # Violation 2: Removes duplicate elements. \\n    # The result is sorted, but its length will be incorrect if duplicates exist across a and b, or within them.\\n    return sorted(list(set(a + b)))\",\n\n  \"def merge_sorted_lists(a, b):\\n    # Violation 3: Sorts the merged list in reverse order.\\n    # This passes the length check and contains all elements, but fails the implicit ascending sort order.\\n    return sorted(a + b, reverse=True)\",\n\n  \"def merge_sorted_lists(a, b):\\n    # Violation 4: Contains extra elements by duplicating all elements from list 'b'.\\n    # The result is sorted, but its length will be incorrect if 'b' is not empty.\\n    return sorted(a + b + b)\",\n\n  \"def merge_sorted_lists(a, b):\\n    # Violation 5: Incorrectly handles empty lists.\\n    # Returns an empty list if *either* input list is empty, instead of the non-empty one.\\n    # If both lists are non-empty, it correctly merges them, making the error specific to empty list cases.\\n    if not a or not b:\\n        return []\\n    return sorted(a + b)\"\n]",
  "39f84829956ee9e56407f433a910c3b1": "from hypothesis import given, strategies as st\n@given(st.lists(st.integers(min_value=-1000, max_value=1000), max_size=10),\n       st.lists(st.integers(min_value=-1000, max_value=1000), max_size=10))\ndef test_merge_sorted_lists(a, b):\n    a_sorted = sorted(a)\n    b_sorted = sorted(b)\n    result = merge_sorted_lists(a_sorted, b_sorted)\n    assert result == sorted(a_sorted + b_sorted)",
  "d89a6de608325231513f08c4f0609207": "[\n  \"def binary_search(lst, target):\\n    low = 0\\n    high = len(lst) - 1\\n    while low <= high:\\n        mid = (low + high) // 2\\n        if lst[mid] == target:\\n            return mid\\n        elif lst[mid] < target:\\n            low = mid + 1\\n        else:\\n            # Violation 1: Incorrect update for 'high'.\\n            # If target is smaller than all elements, this causes an infinite loop.\\n            # Example: lst=[5, 10], target=2. Loop gets stuck with low=0, high=0.\\n            high = mid\\n    return -1\",\n  \"def binary_search(lst, target):\\n    low = 0\\n    high = len(lst) - 1\\n    while low <= high:\\n        mid = (low + high) // 2\\n        if lst[mid] == target:\\n            return mid\\n        elif lst[mid] < target:\\n            # Violation 2: Incorrect update for 'low'.\\n            # If target is larger than all elements, this causes an infinite loop.\\n            # Example: lst=[1, 2], target=3. Loop gets stuck with low=0, high=1.\\n            low = mid\\n        else:\\n            high = mid - 1\\n    return -1\",\n  \"def binary_search(lst, target):\\n    low = 0\\n    high = len(lst) - 1\\n    # Violation 3: Incorrect loop termination condition.\\n    # Using 'low < high' instead of 'low <= high' means the last potential element\\n    # (when low == high) is never checked, leading to incorrect -1 returns.\\n    # Example: lst=[5], target=5. Returns -1, should be 0.\\n    while low < high:\\n        mid = (low + high) // 2\\n        if lst[mid] == target:\\n            return mid\\n        elif lst[mid] < target:\\n            low = mid + 1\\n        else:\\n            high = mid - 1\\n    return -1\",\n  \"def binary_search(lst, target):\\n    low = 0\\n    high = len(lst) - 1\\n    while low <= high:\\n        # Violation 4: Incorrect mid-point calculation.\\n        # This calculation can cause 'mid' to be outside the [low, high] range\\n        # or advance incorrectly, leading to infinite loops or skipping elements.\\n        # Example: lst=list(range(10)), target=9. Causes infinite loop with low=5, high=9, mid=4.\\n        mid = (low + high) // 3\\n        \\n        # Basic check to prevent immediate IndexError for small lists where mid might be invalid\\n        # but the core logic remains flawed.\\n        if not (0 <= mid < len(lst)):\\n            # If mid is completely out of bounds, it's a critical error. Return -1 or break.\\n            # For the purpose of \"might pass a weak spec\", we prevent a crash here.\\n            return -1\\n            \\n        if lst[mid] == target:\\n            return mid\\n        elif lst[mid] < target:\\n            low = mid + 1\\n        else:\\n            high = mid - 1\\n    return -1\",\n  \"def binary_search(lst, target):\\n    low = 0\\n    high = len(lst) - 1\\n    while low <= high:\\n        mid = (low + high) // 2\\n        if lst[mid] == target:\\n            return mid\\n        elif lst[mid] < target:\\n            low = mid + 1\\n        else:\\n            high = mid - 1\\n    # Violation 5: Incorrect return value when target is not found.\\n    # Instead of -1, it always returns 0 if the target is not found.\\n    # Example: lst=[], target=1. Returns 0, should be -1.\\n    # Example: lst=[10, 20, 30], target=15. Returns 0, should be -1.\\n    return 0\"\n]",
  "762eb9eafc31afac2f196af7fdbdf60f": "from hypothesis import given, strategies as st\n\n@given(st.lists(st.integers(min_value=-1000, max_value=1000), max_size=15), st.integers(min_value=-1000, max_value=1000))\ndef test_binary_search(lst, target):\n    lst_sorted = sorted(lst)\n    result = binary_search(lst_sorted, target)\n    if target in lst_sorted:\n        assert 0 <= result < len(lst_sorted)\n        assert lst_sorted[result] == target\n    else:\n        assert result == -1",
  "552a77a518b5dd2a5226fa7c8a2c985d": "[\n  \"def remove_duplicates(lst):\\n    return sorted(list(set(lst)))\",\n  \"def remove_duplicates(lst):\\n    if not lst:\\n        return []\\n    return [lst[0]]\",\n  \"def remove_duplicates(lst):\\n    seen = set()\\n    result = []\\n    for x in reversed(lst):\\n        if x not in seen:\\n            result.append(x)\\n            seen.add(x)\\n    return result[::-1]\",\n  \"def remove_duplicates(lst):\\n    return []\",\n  \"def remove_duplicates(lst):\\n    res = []\\n    for x in lst:\\n        val = abs(x)\\n        if val not in res:\\n            res.append(val)\\n    return res\"\n]",
  "9ec315dbbb1d2c3f787071f151e33960": "from hypothesis import given, strategies as st\n\n@given(st.lists(st.integers(min_value=-100, max_value=100), max_size=15))\ndef test_remove_duplicates(lst):\n    result = remove_duplicates(lst)\n    expected = []\n    for x in lst:\n        if x not in expected:\n            expected.append(x)\n    assert result == expected",
  "12b53efa715952b02ee28ed0fc7999cb": "[\n  \"def rotate_list(lst, k):\\n    # Violation 1: Returns the list unmodified (Identity function)\\n    return list(lst)\",\n  \"def rotate_list(lst, k):\\n    # Violation 2: Rotates the list to the left instead of the right\\n    if not lst:\\n        return []\\n    shift = k % len(lst)\\n    return lst[shift:] + lst[:shift]\",\n  \"def rotate_list(lst, k):\\n    # Violation 3: Returns a list of the correct length but filled with static dummy values\\n    return [0] * len(lst)\",\n  \"def rotate_list(lst, k):\\n    # Violation 4: Reverses the list completely rather than rotating it\\n    return lst[::-1]\",\n  \"def rotate_list(lst, k):\\n    # Violation 5: Ignores the parameter k and always rotates to the right by exactly 1 step\\n    if not lst:\\n        return []\\n    return lst[-1:] + lst[:-1]\"\n]",
  "7e82c85d1a4cb9e6485e1b0a20376224": "from hypothesis import given, strategies as st\n\n@given(st.lists(st.integers(min_value=-100, max_value=100), max_size=15), st.integers(min_value=0, max_value=50))\ndef test_rotate_list(lst, k):\n    result = rotate_list(lst, k)\n    if not lst:\n        assert result == []\n    else:\n        eff_k = k % len(lst)\n        expected = lst[-eff_k:] + lst[:-eff_k] if eff_k > 0 else lst\n        assert result == expected",
  "82bdd55e776bc2f0963950b2fc3da3c2": "[\n  \"def flatten_nested(lst):\\n    return [0] * sum(len(sub) for sub in lst)\",\n  \"def flatten_nested(lst):\\n    return list(range(sum(len(sub) for sub in lst)))\",\n  \"def flatten_nested(lst):\\n    return [str(x) for sub in lst for x in sub]\",\n  \"def flatten_nested(lst):\\n    return [x + 1 for sub in lst for x in sub]\",\n  \"def flatten_nested(lst):\\n    return [len(sub) for sub in lst for _ in sub]\"\n]",
  "30bc3279a5d06c965b697ef6203e6167": "from hypothesis import given, strategies as st\n@given(st.lists(st.lists(st.integers(min_value=-100, max_value=100), max_size=5), max_size=5))\ndef test_flatten_nested(lst):\n    result = flatten_nested(lst)\n    expected = [item for sublist in lst for item in sublist]\n    assert result == expected",
  "c3ffb136206cde2148f20807c4884dff": "[\n  \"def factorial(n):\\n    if n < 0:\\n        raise ValueError(\\\"n must be non-negative\\\")\\n    result = 1\\n    for i in range(1, n + 1):\\n        result *= i\\n    return result\",\n  \"def factorial(n):\\n    if n < 0:\\n        raise ValueError(\\\"n must be non-negative\\\")\\n    memo = {0: 1, 1: 1}\\n    def helper(k):\\n        if k in memo:\\n            return memo[k]\\n        memo[k] = k * helper(k - 1)\\n        return memo[k]\\n    return helper(n)\",\n  \"def factorial(n):\\n    if n < 0:\\n        raise ValueError(\\\"n must be non-negative\\\")\\n    result = 1\\n    for i in range(n):\\n        result *= i\\n    return result\",\n  \"def factorial(n):\\n    import functools\\n    import operator\\n    if n < 0:\\n        raise ValueError(\\\"n must be non-negative\\\")\\n    if n == 0:\\n        return 1\\n    return functools.reduce(operator.mul, range(1, n + 1))\",\n  \"def factorial(n):\\n    if n < 0:\\n        raise ValueError(\\\"n must be non-negative\\\")\\n    if n == 1:\\n        return 1\\n    return n * factorial(n - 1)\"\n]",
  "e1c94730cbae6547ff4af036bfbb9347": "[\n  \"def factorial(n):\\n    return n + 5\",\n  \"def factorial(n):\\n    return 2 ** (n + 1)\",\n  \"def factorial(n):\\n    return 42\",\n  \"def factorial(n):\\n    import math\\n    return math.factorial(n) + 2\",\n  \"def factorial(n):\\n    return n * n + 1\"\n]",
  "2985f53baae473a6a2f54d61a252116e": "from hypothesis import given, strategies as st\nimport math\n\n@given(st.integers(min_value=0, max_value=15))\ndef test_factorial(n):\n    result = factorial(n)\n    assert result == math.factorial(n)",
  "8ed9f3670d270e54b095bfecfd19d739": "[\n  \"def gcd(a, b):\\n    while b:\\n        a, b = b, a % b\\n    return abs(a)\",\n  \"def gcd(a, b):\\n    def rec(x, y):\\n        if y == 0:\\n            return x\\n        return rec(y, x % y)\\n    return abs(rec(a, b))\",\n  \"def gcd(a, b):\\n    if a == 0: return abs(b)\\n    if b == 0: return abs(a)\\n    while a != b:\\n        if a > b:\\n            a = a - b\\n        else:\\n            b = b - a\\n    return a\",\n  \"def gcd(a, b):\\n    a, b = abs(a), abs(b)\\n    if a == 0: return b\\n    if b == 0: return a\\n    for i in range(min(a, b), 0, -1):\\n        if a % i == 0 and b % i == 0:\\n            return i\\n    return 1\",\n  \"def gcd(a, b):\\n    a, b = abs(a), abs(b)\\n    if a == 0: return b\\n    if b == 0: return a\\n    shift = 0\\n    while ((a | b) & 1) == 0:\\n        a >>= 1\\n        b >>= 1\\n        shift += 1\\n    while (a & 1) == 0:\\n        a >>= 1\\n    while b != 0:\\n        while (b & 1) == 0:\\n            b >>= 1\\n        if a > b:\\n            a, b = b, a\\n        b = b - a\\n    return a << shift\"\n]",
  "a49592df76047099ddd32d96bc974b6f": "[\n  \"def gcd(a, b):\\n    return 1\",\n  \"def gcd(a, b):\\n    return min(abs(a), abs(b))\",\n  \"def gcd(a, b):\\n    return abs(a) if abs(a) == abs(b) else 1\",\n  \"def gcd(a, b):\\n    return abs(a * b)\",\n  \"def gcd(a, b):\\n    return abs(a - b)\"\n]"
}