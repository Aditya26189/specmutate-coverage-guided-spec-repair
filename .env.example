# SpecMutate — Environment Configuration Template
# Copy this to .env and fill in your Google Gemini API keys.
# Get keys at: https://aistudio.google.com/app/apikey

# Primary key (required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Additional keys for rotation (optional but recommended to avoid quota limits)
# GOOGLE_API_KEY_1=your_second_key_here
# GOOGLE_API_KEY_2=your_third_key_here
# GOOGLE_API_KEY_3=your_fourth_key_here
# GOOGLE_API_KEY_4=your_fifth_key_here
# GOOGLE_API_KEY_5=your_sixth_key_here
